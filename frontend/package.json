{
  "name": "marea-roja-web",
  "private": true,
  "version": "1.0.0",
  "description": "SPA de administración del Club Deportivo Marea Roja",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e": "start-server-and-test \"npm run e2e:servers\" http://127.0.0.1:5173 \"cypress run\"",
    "e2e:servers": "concurrently -k \"npm:e2e:api\" \"npm:dev -- --host 127.0.0.1\"",
    "e2e:api": "cd ../backend && php artisan migrate:fresh --seed --force && php artisan serve --host=127.0.0.1 --port=8080"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "chart.js": "^4.5.1",
    "lucide": "^1.56.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "start-server-and-test": "^3.0.12",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
