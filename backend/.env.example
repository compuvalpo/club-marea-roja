APP_NAME="Marea Roja"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Santiago
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos. SQLite por defecto (database/database.sqlite).
# Para MySQL: DB_CONNECTION=mysql, DB_HOST, DB_PORT=3306, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# Para PostgreSQL: DB_CONNECTION=pgsql, DB_PORT=5432, ...
DB_CONNECTION=sqlite

# La API es stateless: no usa sesiones de servidor.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# JWT: genere el secreto con  php artisan jwt:secret
JWT_SECRET=
JWT_ISSUER=marea-roja-api
JWT_AUDIENCE=marea-roja-web
# Duración del access token (s). Recomendado 5–15 min.
JWT_ACCESS_TTL=900
# Cierre de sesión por inactividad (s) y duración máxima absoluta de una sesión (s).
JWT_IDLE_TTL=1800
JWT_SESSION_TTL=28800
# true = una sola sesión por usuario: iniciar sesión en otra pestaña o equipo cierra la anterior.
JWT_SINGLE_SESSION=true

# Orígenes permitidos (separados por coma) y cookies seguras (true en HTTPS)
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
